{
  "name": "PokerTH Rocky 8 GCC14",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "containerEnv": {
    "CC": "gcc",
    "CXX": "g++"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools"
      ]
    }
  },
  "containerUser": "pokerth",
  "remoteUser": "pokerth",
  "updateRemoteUserUID": true
}
