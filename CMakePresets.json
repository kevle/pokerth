{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 19,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vcpkg-base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "description": "Expects VCPKG_ROOT to be set in the environment.",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_HOST_TRIPLET": "x64-linux",
        "CMAKE_EXE_LINKER_FLAGS_INIT": "-fuse-ld=mold",
        "CMAKE_SHARED_LINKER_FLAGS_INIT": "-fuse-ld=mold",
        "CMAKE_MODULE_LINKER_FLAGS_INIT": "-fuse-ld=mold"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug",
      "description": "Configure Linux Debug build with vcpkg toolchain.",
      "inherits": [
        "vcpkg-base",
        "linux-base"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release",
      "description": "Configure Linux Release build with vcpkg toolchain.",
      "inherits": [
        "vcpkg-base",
        "linux-base"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    }
  ]
}
