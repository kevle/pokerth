{
  "name": "pokerth",
  "version-string": "1.0.0",
  "dependencies": [
    "boost-asio",
    "boost-chrono",
    "boost-date-time",
    "boost-filesystem",
    "boost-foreach",
    "boost-interprocess",
    "boost-lambda",
    "boost-program-options",
    "boost-random",
    "boost-system",
    "boost-thread",
    "boost-uuid",
    {
      "name": "boost-iostreams",
      "features": [
        "bzip2",
        "zlib"
      ]
    },
    {
      "name": "libsystemd",
      "default-features": false,
      "platform": "linux"
    },
    "openssl",
    "protobuf",
    "abseil",
    "utf8-range",
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "sql",
        "sql-sqlite",
        "gui",
        "freetype",
        "openssl"
      ]
    },
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "xcb"
      ],
      "platform": "linux"
    },
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "gles2",
        "opengl"
      ],
      "platform": "emscripten"
    },
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": [
        "swresample",
        "swscale"
      ]
    },
    "qtdeclarative",
    "qtquickcontrols2",
    "qtsvg",
    "qtwebsockets",
    "qttools",
    {
      "name": "qtmultimedia",
      "default-features": false,
      "features": [
        "widgets"
      ]
    },
    {
      "name": "qtmultimedia",
      "default-features": false,
      "features": [
        "ffmpeg"
      ],
      "platform": "!emscripten"
    }
  ]
}